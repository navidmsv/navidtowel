/* =========================================================
   GET
========================================================= */

function doGet(e) {

  try {

    var p =
      e && e.parameter
        ? e.parameter
        : {};

    if (
      !p.firstName &&
      !p.action &&
      !p.stage &&
      !p.orderNumber
    ) {

      return respond(
        e,
        listOrdersObject()
      );
    }

    if (
      p.stage ||
      p.action === "payment_confirmed" ||
      p.action === "final" ||
      p.action === "submitOrder"
    ) {

      return respond(
        e,
        handleCheckout(p)
      );
    }

    if (p.firstName) {

      return respond(
        e,
        handleCheckout(p)
      );
    }

    return respond(e, {
      ok: false,
      error: "درخواست نامعتبر است."
    });

  } catch (error) {

    return respond(e, {
      ok: false,
      error: String(
        error.message || error
      )
    });
  }
}


/* =========================================================
   POST
========================================================= */

function doPost(e) {

  try {

    if (ORDER_API_KEY) {

      var key =
        (
          e &&
          e.parameter &&
          e.parameter.key
        ) ||
        (
          e &&
          e.headers &&
          e.headers["x-api-key"]
        ) ||
        "";

      if (key !== ORDER_API_KEY) {

        return json({
          ok: false,
          error: "Unauthorized"
        });
      }
    }

    var raw =
      e &&
      e.postData &&
      e.postData.contents
        ? e.postData.contents
        : "{}";

    var data;

    try {

      data = JSON.parse(raw);

    } catch (error) {

      data = e.parameter || {};
    }

    if (
      data.action === "payment_confirmed" ||
      data.stage === "payment_confirmed"
    ) {

      return json(
        handleCheckout(data)
      );
    }

    if (
      data.action === "final" ||
      data.stage === "final" ||
      data.action === "submitOrder"
    ) {

      return json(
        handleCheckout(data)
      );
    }

    if (
      data.action === "shipment" ||
      data.action === "navidtowel_shipment"
    ) {

      return json(
        saveCell(
          data.orderNumber,
          "shipmentCode",
          clean(data.shipmentCode),
          "کد مرسوله"
        )
      );
    }

    if (data.action === "status") {

      return json(
        saveCell(
          data.orderNumber,
          "status",
          clean(data.status),
          "وضعیت"
        )
      );
    }

    return json({
      ok: false,
      error: "Unknown action"
    });

  } catch (error) {

    return json({
      ok: false,
      error: String(
        error.message || error
      )
    });
  }
}


/* =========================================================
   CHECKOUT
========================================================= */

function handleCheckout(p) {

  var lock = LockService.getScriptLock();

  try {

    lock.waitLock(10000);

    p = p || {};

    var stage =
      clean(
        p.stage ||
        p.action ||
        "final"
      );

    if (stage === "submitOrder") {
      stage = "final";
    }

    if (
      stage !== "payment_confirmed" &&
      stage !== "final"
    ) {

      return {
        ok: false,
        error: "مرحله سفارش نامعتبر است."
      };
    }


    /* مشتری */

    var firstName = clean(p.firstName);
    var lastName = clean(p.lastName);

    var mobile =
      normalizeDigits(
        clean(p.mobile)
      );

    var province = clean(p.province);
    var city = clean(p.city);

    var postalCode =
      normalizeDigits(
        clean(p.postalCode)
      );

    var address = clean(p.address);
    var note = clean(p.note);


    /* محصولات */

    var products =
      clean(
        p.products ||
        p.items ||
        p.orderProducts
      );

    var subtotal =
      numberValue(p.subtotal);

    var shippingCost =
      numberValue(p.shippingCost);

    var total =
      numberValue(p.total);

    var shipping =
      clean(
        p.shipping ||
        p.shippingMethod
      );


    /* پرداخت */

    var paymentMethod =
      clean(
        p.paymentMethod ||
        p.payment ||
        p.payment_method
      );

    var transferTracking =
      normalizeTracking(
        p.transferTrackingNumber ||
        p.transferTracking ||
        p.transferTrackingCode ||
        p.cardTransferTracking
      );

    var gatewayTracking =
      normalizeTracking(
        p.gatewayTrackingCode ||
        p.gatewayTracking ||
        p.gatewayTransactionId ||
        p.transactionId
      );

    if (isCardToCard(paymentMethod)) {
      gatewayTracking = "";
    }


    /* خلاصه ارسال */

    var shippingSummary =
      clean(p.shippingSummary);

    if (!shippingSummary) {

      shippingSummary =
        buildShippingSummary(
          shipping,
          shippingCost,
          note
        );
    }


    /* اعتبارسنجی */

    if (!firstName) {

      return {
        ok: false,
        error: "نام مشتری وارد نشده است."
      };
    }

    if (!mobile) {

      return {
        ok: false,
        error: "شماره موبایل وارد نشده است."
      };
    }

    if (!products) {

      return {
        ok: false,
        error: "محصولات سفارش مشخص نیست."
      };
    }

    if (isCardToCard(paymentMethod)) {

      if (
        !isValidTransferTracking(
          transferTracking
        )
      ) {

        return {
          ok: false,
          error:
            "کد رهگیری کارت‌به‌کارت باید 10 تا 13 رقم باشد."
        };
      }
    }


    /* Fingerprint */

    var fingerprint =
      createOrderFingerprint({

        firstName: firstName,
        lastName: lastName,
        mobile: mobile,
        province: province,
        city: city,
        postalCode: postalCode,
        address: address,
        shipping: shipping,
        products: products,
        subtotal: subtotal,
        shippingCost: shippingCost,
        total: total,
        note: note,
        paymentMethod: paymentMethod,
        transferTracking: transferTracking,
        gatewayTracking: gatewayTracking
      });


    /* گرفتن شیت */

    var sheet = getSheet();

    var columns = getColumns(sheet);

    var existing =
      findOrderByFingerprint(
        sheet,
        columns,
        fingerprint
      );


    /* =====================================================
       PAYMENT CONFIRMED
    ===================================================== */

    if (stage === "payment_confirmed") {

      var paymentOrderNumber;
      var paymentRow;

      if (existing) {

        paymentRow = existing.row;

        paymentOrderNumber =
          getCellByKey(
            sheet,
            paymentRow,
            columns,
            "orderNumber"
          );

        if (!paymentOrderNumber) {

          paymentOrderNumber =
            createOrderNumber();
        }

        updateOrderRow(
          sheet,
          paymentRow,
          columns,
          {

            orderNumber: paymentOrderNumber,
            firstName: firstName,
            lastName: lastName,
            mobile: mobile,
            province: province,
            city: city,
            postalCode: postalCode,
            address: address,
            shipping: shipping,
            products: products,
            subtotal: subtotal,
            shippingCost: shippingCost,
            total: total,
            note: note,
            paymentMethod: paymentMethod,
            transferTracking: transferTracking,
            gatewayTracking: gatewayTracking,
            shippingSummary: shippingSummary,
            fingerprint: fingerprint,
            checkoutStage: "payment_confirmed"

          },
          false
        );

        saveFingerprintRow(
          fingerprint,
          paymentRow
        );

      } else {

        paymentOrderNumber =
          createOrderNumber();

        paymentRow =
          appendOrderRow(
            sheet,
            columns,
            {

              orderNumber: paymentOrderNumber,
              firstName: firstName,
              lastName: lastName,
              mobile: mobile,
              province: province,
              city: city,
              postalCode: postalCode,
              address: address,
              shipping: shipping,
              products: products,
              subtotal: subtotal,
              shippingCost: shippingCost,
              total: total,
              note: note,
              paymentMethod: paymentMethod,
              transferTracking: transferTracking,
              gatewayTracking: gatewayTracking,
              shippingSummary: shippingSummary,
              fingerprint: fingerprint,
              checkoutStage: "payment_confirmed",
              telegramSent: "false"

            },
            false
          );

        saveFingerprintRow(
          fingerprint,
          paymentRow
        );
      }

      return {

        ok: true,
        stage: "payment_confirmed",
        savedToSheet: true,
        duplicate: !!existing,
        row: paymentRow,

        /*
          عمداً کد پیگیری سایت
          در این مرحله ارسال نمی‌شود.
        */

        trackingCode: "",
        transferTracking:
          transferTracking

      };
    }


    /* =====================================================
       FINAL
    ===================================================== */

    if (stage === "final") {

      var finalOrderNumber;
      var siteTrackingCode;
      var finalRow;


      /* سفارش قبلی وجود دارد */

      if (existing) {

        finalRow = existing.row;

        finalOrderNumber =
          getCellByKey(
            sheet,
            finalRow,
            columns,
            "orderNumber"
          );

        if (!finalOrderNumber) {

          finalOrderNumber =
            createOrderNumber();
        }

        siteTrackingCode =
          getCellByKey(
            sheet,
            finalRow,
            columns,
            "trackingCode"
          );

        if (!siteTrackingCode) {

          siteTrackingCode =
            createTrackingCode();
        }

        var telegramAlreadySent =
          getCellByKey(
            sheet,
            finalRow,
            columns,
            "telegramSent"
          );

        updateOrderRow(
          sheet,
          finalRow,
          columns,
          {

            orderNumber: finalOrderNumber,
            firstName: firstName,
            lastName: lastName,
            mobile: mobile,
            province: province,
            city: city,
            postalCode: postalCode,
            address: address,
            shipping: shipping,
            products: products,
            subtotal: subtotal,
            shippingCost: shippingCost,
