          trackingCode: siteTrackingCode,
          paymentMethod: paymentMethod,
          transferTracking: transferTracking

        });


      if (telegramResult) {

        setCellByKey(
          sheet,
          finalRow,
          columns,
          "telegramSent",
          "true"
        );
      }


      return {

        ok: true,
        stage: "final",
        savedToSheet: true,
        duplicate: false,
