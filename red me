/* =========================================================
   HELPERS
========================================================= */

function clean(value) {

  if (
    value === null ||
    value === undefined
  ) {

    return "";
  }


  return String(value).trim();
}


function numberValue(value) {

  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {

    return 0;
  }


  var normalized =
    normalizeDigits(
      String(value)
    )
      .replace(
        /[,٬،\s]/g,
        ""
      )
      .replace(
        /تومان/g,
        ""
      );


  var n =
    Number(normalized);


  return isFinite(n)
    ? n
    : 0;
}


function normalizeDigits(value) {

  return String(value || "")

    .replace(
      /[۰-۹]/g,
      function(c) {

        return "۰۱۲۳۴۵۶۷۸۹"
          .indexOf(c);

      }
    )

    .replace(
      /[٠-٩]/g,
      function(c) {

        return "٠١٢٣٤٥٦٧٨٩"
          .indexOf(c);

      }
    );
}


function normalizeTracking(value) {

  return normalizeDigits(
    clean(value)
  )
    .replace(
      /\D/g,
      ""
    );
}


function isValidTransferTracking(value) {

  return /^\d{10,13}$/.test(
    String(value || "")
  );
}


function isCardToCard(paymentMethod) {

  var value =
    clean(paymentMethod)
      .replace(
        /\u200c/g,
        ""
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim()
      .toLowerCase();


  return (
    value === "کارت به کارت" ||
    value === "card" ||
    value === "card_to_card" ||
    value === "card-to-card"
  );
}


function buildShippingSummary(
  shipping,
  shippingCost,
  note
) {

  var result =
    shipping ||
    "ثبت نشده";


  if (
    Number(shippingCost) > 0
  ) {

    result +=
      " = " +
      formatMoney(shippingCost) +
      " تومان";
  }


  result +=
    " | توضیحات مشتری: " +
    (
      note ||
      "ندارد"
    );


  return result;
}


/* =========================================================
   شماره سفارش
========================================================= */

function createOrderNumber() {

  var date =
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone(),
      "yyMMdd"
    );


  var random =
    Math.floor(
      1000 +
      Math.random() * 9000
    );


  return (
    "NT-" +
    date +
    "-" +
    random
  );
}


/* =========================================================
   کد رهگیری سایت
========================================================= */

function createTrackingCode() {

  var random =
    Math.floor(
      100000 +
      Math.random() * 900000
    );


  return (
    "NT" +
    random
  );
}


/* =========================================================
   MONEY
========================================================= */

function formatMoney(value) {

  return Number(
    value || 0
  ).toLocaleString(
    "en-US"
  );
}


/* =========================================================
   RESPONSE / JSONP
========================================================= */

function respond(e, data) {

  var callback =
    e &&
    e.parameter &&
    e.parameter.callback
      ? String(
          e.parameter.callback
        )
      : "";


  if (
    callback &&
    /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(
      callback
    )
  ) {

    return ContentService
      .createTextOutput(
        callback +
        "(" +
        JSON.stringify(data) +
        ");"
      )
      .setMimeType(
        ContentService.MimeType.JAVASCRIPT
      );
  }


  return json(data);
}


function json(data) {

  return ContentService
    .createTextOutput(
      JSON.stringify(data)
    )
    .setMimeType(
      ContentService.MimeType.JSON
    );
}








