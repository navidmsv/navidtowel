            checkoutStage: "final",
            telegramSent:
              telegramAlreadySent || "false"

          },
          true
        );

        saveFingerprintRow(
          fingerprint,
          finalRow
        );


        if (
          telegramAlreadySent !== "true"
        ) {

          var telegramResult =
            sendTelegramOrder({

              firstName: firstName,
              lastName: lastName,
              mobile: mobile,
              province: province,
              city: city,
              address: address,
              products: products,
              total: total,
              orderNumber: finalOrderNumber,
              trackingCode: siteTrackingCode,
