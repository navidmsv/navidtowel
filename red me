          if (telegramResult) {

            setCellByKey(
              sheet,
              finalRow,
              columns,
              "telegramSent",
              "true"
            );
          }
        }


        return {

          ok: true,
          stage: "final",
          savedToSheet: true,
          duplicate: true,
          row: finalRow,
          orderNumber: finalOrderNumber,
          trackingCode: siteTrackingCode

        };
      }


      /* سفارش کاملاً جدید */

      finalOrderNumber =
        createOrderNumber();

      siteTrackingCode =
        createTrackingCode();

      finalRow =
        appendOrderRow(
          sheet,
          columns,
          {

            orderNumber: finalOrderNumber,
            firstName: firstName,
            lastName: lastName,
            mobile: mobile,
            province: province,
            city: city,
            postalCode: postalCode,
            address: address,
            shipping: shipping,
            products: products,
            subtotal: subtotal,
            shippingCost: shippingCost,
            total: total,
            note: note,
            paymentMethod: paymentMethod,
            transferTracking: transferTracking,
            gatewayTracking: gatewayTracking,
            shippingSummary: shippingSummary,
            trackingCode: siteTrackingCode,
            fingerprint: fingerprint,
            checkoutStage: "final",
            telegramSent: "false"

          },
          true
        );

      saveFingerprintRow(
