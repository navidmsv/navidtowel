    ]);

    var message =
      "🛍 خرید جدید در NavidTowel\n\n" +
      "👤 نام مشتری: " + fullName + "\n" +
      "📱 شماره موبایل: " + (mobile || "وارد نشده") + "\n\n" +
      "🛒 سفارش:\n" + (products || "محصولی ثبت نشده") + "\n\n" +
      "💰 مبلغ پرداختی: " + formatMoney(total) + " تومان\n\n" +
      "📍 آدرس:\n" + fullAddress;

    var telegramUrl =
      "https://api.telegram.org/bot" + TELEGRAM_TOKEN + "/sendMessage";

    var telegramResult = { ok: false };

    try {
      var telegramResponse = UrlFetchApp.fetch(telegramUrl, {
        method: "post",
        payload: {
          chat_id: TELEGRAM_CHAT_ID,
          text: message
        },
        muteHttpExceptions: true
      });

      telegramResult = JSON.parse(telegramResponse.getContentText());
    } catch (telegramError) {
      telegramResult = { ok: false };
    }

    return json({
      ok: true,
      savedToSheet: true,
      telegramSent: telegramResult.ok === true,
      orderNumber: orderNumber,
      trackingCode: trackingCode
    });
  } catch (error) {
    return json({
      ok: false,
      error: String(error.message || error)
    });
  }
}

/* =========================================================
   لیست سفارش‌ها (برای ربات ادمین)
========================================================= */

function listOrders() {
  try {
    var sheet = getSheet();
    var values = sheet.getDataRange().getValues();

    var orders = [];

    for (var i = 0; i < values.length; i++) {
      var row = values[i];

      var isEmpty = row.every(function (cell) {
        return String(cell || "").trim() === "";
      });

      if (isEmpty) {
        continue;
      }

      orders.push({
        rowNumber: i + 1,
        orderNumber: clean(row[COL.orderNumber - 1]),
        date: clean(row[COL.date - 1]),
        name: clean(row[COL.firstName - 1]),
        lastName: clean(row[COL.lastName - 1]),
        mobile: clean(row[COL.mobile - 1]),
        province: clean(row[COL.province - 1]),
        city: clean(row[COL.city - 1]),
        postalCode: clean(row[COL.postalCode - 1]),
        address: clean(row[COL.address - 1]),
        shipping: clean(row[COL.shipping - 1]),
        products: clean(row[COL.products - 1]),
        subtotal: clean(row[COL.subtotal - 1]),
        shippingCost: clean(row[COL.shippingCost - 1]),
        total: clean(row[COL.total - 1]),
        notes: clean(row[COL.note - 1]),
        trackingCode: clean(row[COL.trackingCode - 1]),
        shipmentCode: clean(row[COL.shipmentCode - 1]),
        status: clean(row[COL.status - 1])
      });
    }

    return json({ ok: true, orders: orders });
  } catch (err) {
    return json({ ok: false, error: err.message });
  }
}

/* =========================================================
   doPost — فقط برای ربات ادمین (ثبت کد مرسوله / وضعیت)
========================================================= */

function doPost(e) {
  try {
    if (ORDER_API_KEY) {
      var key =
        (e && e.parameter && e.parameter.key) ||
        (e && e.headers && e.headers["x-api-key"]) ||
        "";

      if (key !== ORDER_API_KEY) {
        return json({ ok: false, error: "Unauthorized" });
      }
    }

    var data = JSON.parse(
      (e && e.postData && e.postData.contents) || "{}"
    );

    if (data.action === "shipment" || data.action === "navidtowel_shipment") {
      return saveCell(
        data.orderNumber,
        COL.shipmentCode,
        clean(data.shipmentCode),
        "کد مرسوله"
      );
    }

    if (data.action === "status") {
      return saveCell(
        data.orderNumber,
        COL.status,
        clean(data.status),
        "وضعیت"
      );
    }

    return json({ ok: false, error: "Unknown action" });
  } catch (err) {
    return json({ ok: false, error: err.message });
  }
}

function saveCell(orderNumber, col, value, label) {
  orderNumber = clean(orderNumber);

  if (!orderNumber) {
    return json({ ok: false, error: "کد سفارش مشخص نیست" });
  }

  if (!value) {
    return json({ ok: false, error: label + " خالی است" });
  }

  var sheet = getSheet();
  var rowNumber = findOrderRow(sheet, orderNumber);

  if (!rowNumber) {
    return json({ ok: false, error: "سفارش پیدا نشد" });
  }

  sheet.getRange(rowNumber, col).setValue(value);

  return json({
    ok: true,
    message: label + " ثبت شد",
    row: rowNumber,
    value: value
  });
}

function findOrderRow(sheet, orderNumber) {
  var values = sheet.getDataRange().getValues();

  for (var i = 0; i < values.length; i++) {
    var row = values[i];

    for (var j = 0; j < row.length; j++) {
      if (clean(row[j]) === orderNumber) {
        return i + 1;
      }
    }
  }

  return null;
}

/* =========================================================
   SHEET
========================================================= */

function getSheet() {
  var ss = SpreadsheetApp.openById(SHEET_ID);
  var sheet = ss.getSheetByName(SHEET_NAME);

  if (!sheet) {
    throw new Error("شیت " + SHEET_NAME + " پیدا نشد.");
  }

  return sheet;
}

/* =========================================================
   HELPERS
========================================================= */

function clean(value) {
  if (value === null || value === undefined) {
    return "";
  }

  return String(value).trim();
}

function createOrderNumber() {
  var date = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    "yyMMdd"
  );

  var random = Math.floor(1000 + Math.random() * 9000);

  return "NT-" + date + "-" + random;
}

function createTrackingCode() {
  var random = Math.floor(100000 + Math.random() * 900000);

  return "NT" + random;
}

function formatMoney(value) {
  return Number(value || 0).toLocaleString("en-US");
}

function json(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}















