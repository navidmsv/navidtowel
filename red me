/* =========================================================
   CELL HELPERS
========================================================= */

function getCellByKey(
  sheet,
  rowNumber,
  columns,
  key
) {

  var col =
    columns[key];


  if (!col) {
    return "";
  }


  return clean(
    sheet
      .getRange(
        rowNumber,
        col
      )
      .getDisplayValue()
  );
}


function setCellByKey(
  sheet,
  rowNumber,
  columns,
  key,
  value
) {

  var col =
    columns[key];


  if (!col) {
    return;
  }


  sheet
    .getRange(
      rowNumber,
      col
    )
    .setValue(
      value == null
        ? ""
        : value
    );
}


function getArrayCell(
  row,
  columns,
  key
) {

  var col =
    columns[key];


  if (
    !col ||
    col > row.length
  ) {

    return "";
  }


  return clean(
    row[col - 1]
  );
}


function setArrayCell(
  row,
  columns,
  key,
  value
) {

  var col =
    columns[key];


  if (!col) {
    return;
  }


  while (
    row.length < col
  ) {

    row.push("");
  }


  row[col - 1] =
    value == null
      ? ""
      : value;
}


