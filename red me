/* =========================================================
   APPEND
   مهم: اگر sheet خالی باشد، خودش Sheet را می‌گیرد.
========================================================= */

function appendOrderRow(
  sheet,
  columns,
  data,
  finalOrder
) {

  if (!sheet) {
    sheet = getSheet();
  }

  if (!sheet) {
    throw new Error(
      "Google Sheet پیدا نشد."
    );
  }


  var lastColumn =
    sheet.getLastColumn();


  var width =
    Math.max(
      lastColumn,
      18
    );


  var row =
    new Array(width).fill("");


  writeRowData(
    row,
    columns,
    data,
    finalOrder
  );


  sheet.appendRow(row);


  return sheet.getLastRow();
}


/* =========================================================
   UPDATE
========================================================= */

function updateOrderRow(
  sheet,
  rowNumber,
  columns,
  data,
  finalOrder
) {

  if (!sheet) {
    sheet = getSheet();
  }

  if (!sheet) {
    throw new Error(
      "Google Sheet پیدا نشد."
    );
  }


  var width =
    Math.max(
      sheet.getLastColumn(),
      18
    );


  var range =
    sheet.getRange(
      rowNumber,
      1,
      1,
      width
    );


  var row =
    range.getValues()[0];


  writeRowData(
    row,
    columns,
    data,
    finalOrder
  );


  range.setValues([
    row
  ]);
}


/* =========================================================
   WRITE ROW
========================================================= */

function writeRowData(
  row,
  columns,
  data,
  finalOrder
) {

  setArrayCell(
    row,
    columns,
    "orderNumber",
    data.orderNumber
  );


  if (
    !getArrayCell(
      row,
      columns,
      "date"
    )
  ) {

    setArrayCell(
      row,
      columns,
      "date",
      Utilities.formatDate(
        new Date(),
        Session.getScriptTimeZone(),
        "yyyy/MM/dd HH:mm:ss"
      )
    );
  }


  var fields = [

    "firstName",
    "lastName",
    "mobile",
    "province",
    "city",
    "postalCode",
    "address",
    "shipping",
    "products",
    "subtotal",
    "shippingCost",
    "total",
    "note",
    "paymentMethod",
    "transferTracking",
    "gatewayTracking",
    "shippingSummary",
    "fingerprint"

  ];


  fields.forEach(function(key) {

    setArrayCell(
      row,
      columns,
      key,
      data[key]
    );

  });


  if (data.checkoutStage) {

    setArrayCell(
      row,
      columns,
      "checkoutStage",
      data.checkoutStage
    );
  }


  if (
    data.telegramSent !== undefined
  ) {

    setArrayCell(
      row,
      columns,
      "telegramSent",
      data.telegramSent
    );
  }


  if (
    finalOrder &&
    data.trackingCode
  ) {

    setArrayCell(
      row,
      columns,
      "trackingCode",
      data.trackingCode
    );
  }
}


/* =========================================================
   GET COLUMNS
========================================================= */

function getColumns(sheet) {

  if (!sheet) {
    sheet = getSheet();
  }


  ensureRequiredHeaders(sheet);


  var lastColumn =
    Math.max(
      sheet.getLastColumn(),
      18
    );


  var headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  var columns = {};


  Object.keys(
    HEADER_ALIASES
  ).forEach(function(key) {

    columns[key] =
      findHeaderColumn(
        headers,
        HEADER_ALIASES[key]
      );

  });


  Object.keys(COL).forEach(
    function(key) {

      if (!columns[key]) {
        columns[key] = COL[key];
      }

    }
  );


  return columns;
}


/* =========================================================
   REQUIRED HEADERS
========================================================= */

function ensureRequiredHeaders(sheet) {

  if (!sheet) {
    sheet = getSheet();
  }


  var lastColumn =
    Math.max(
      sheet.getLastColumn(),
      18
    );


  var headers =
    sheet
      .getRange(
        1,
        1,
        1,
        lastColumn
      )
      .getDisplayValues()[0];


  Object.keys(
    NEW_HEADERS
  ).forEach(function(key) {

    var found =
      findHeaderColumn(
        headers,
        HEADER_ALIASES[key] || []
      );


    if (found) {
      return;
    }


    var newColumn =
      sheet.getLastColumn() + 1;


    sheet
      .getRange(
        1,
        newColumn
      )
      .setValue(
        NEW_HEADERS[key]
      );


    headers.push(
      NEW_HEADERS[key]
    );

  });
}


/* =========================================================
   HEADER SEARCH
========================================================= */

function findHeaderColumn(
  headers,
  aliases
) {

  for (
    var i = 0;
    i < headers.length;
    i++
  ) {

    var h =
      normalizeHeader(
        headers[i]
      );


    if (!h) {
      continue;
    }


    for (
      var j = 0;
      j < aliases.length;
      j++
    ) {

      if (
        h ===
        normalizeHeader(
          aliases[j]
        )
      ) {

        return i + 1;
      }
    }
  }


  return null;
}


function normalizeHeader(value) {

  return normalizeDigits(
    String(value || "")
  )
    .trim()
    .toLowerCase()
    .replace(
      /[\s‌_()-]+/g,
      ""
    );
}


/* =========================================================
   FIND FINGERPRINT
========================================================= */

function findOrderByFingerprint(
  sheet,
  columns,
  fingerprint
) {

  if (!fingerprint) {
    return null;
  }


  var lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return null;
  }


  if (columns.fingerprint) {

    var values =
      sheet
        .getRange(
          2,
          columns.fingerprint,
          lastRow - 1,
          1
        )
        .getDisplayValues();


    for (
      var i = 0;
      i < values.length;
      i++
    ) {

      if (
        clean(values[i][0]) ===
        fingerprint
      ) {

        return {

          row: i + 2,

          orderNumber:
            getCellByKey(
              sheet,
              i + 2,
              columns,
              "orderNumber"
            )

        };
      }
    }
  }


  var props =
    PropertiesService
      .getScriptProperties();


  var savedRow =
    props.getProperty(
      "ORDER_FP_" +
      fingerprint
    );


  if (savedRow) {

    var rowNumber =
      Number(savedRow);


    if (
      rowNumber >= 2 &&
      rowNumber <= lastRow
    ) {

      var savedFingerprint =
        getCellByKey(
          sheet,
          rowNumber,
          columns,
          "fingerprint"
        );


      if (
        savedFingerprint ===
        fingerprint
      ) {

        return {

          row: rowNumber,

          orderNumber:
            getCellByKey(
              sheet,
              rowNumber,
              columns,
              "orderNumber"
            )

        };
      }
    }
  }


  return null;
}


