    message:
      label +
      " ثبت شد.",

    row:
      rowNumber,

    value:
      value
  };
}


/* =========================================================
   FIND ORDER
========================================================= */

function findOrderRow(
  sheet,
  columns,
  orderNumber
) {

  var lastRow =
    sheet.getLastRow();


  if (lastRow < 2) {
    return null;
  }


  var col =
    columns.orderNumber ||
    COL.orderNumber;


  var values =
    sheet
      .getRange(
        2,
        col,
        lastRow - 1,
        1
      )
      .getDisplayValues();


  for (
    var i = 0;
    i < values.length;
    i++
  ) {

    if (
      clean(values[i][0]) ===
      orderNumber
    ) {

      return i + 2;
    }
  }


  return null;
}


/* =========================================================
   FINGERPRINT
========================================================= */

function createOrderFingerprint(data) {

  var source = [

    clean(data.firstName),
    clean(data.lastName),

    normalizeDigits(
      clean(data.mobile)
    ),

    clean(data.province),
    clean(data.city),

    normalizeDigits(
      clean(data.postalCode)
    ),

    clean(data.address),
    clean(data.shipping),
    clean(data.products),

    numberValue(data.subtotal),
    numberValue(data.shippingCost),
    numberValue(data.total),

    clean(data.note),
    clean(data.paymentMethod),

    normalizeTracking(
      data.transferTracking
    ),

    normalizeTracking(
      data.gatewayTracking
    )

  ]
    .map(function(value) {

      return String(
        value == null
          ? ""
          : value
      );

    })
    .join("\u001F");


  var bytes =
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_256,
      source,
      Utilities.Charset.UTF_8
    );


  return bytes
    .map(function(byte) {

      var value =
        byte < 0
          ? byte + 256
          : byte;

      return value
        .toString(16)
        .padStart(2, "0");

    })
    .join("");
}


