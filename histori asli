  می‌تونه با حدس زدن، آدرس و نام بقیه رو ببینه.
*/
var ALLOW_FULL_DETAILS_WITH_SINGLE_FIELD = false;

/* =========================================================
   SECRETS (از Script Properties، نه از داخل کد)
========================================================= */

function secret_(name) {
  return PropertiesService.getScriptProperties().getProperty(name) || "";
}

function telegramToken_() { return secret_("TELEGRAM_TOKEN"); }
function telegramChatId_() { return secret_("TELEGRAM_CHAT_ID") || "512163391"; }
function adminKey_() { return secret_("ORDER_API_KEY"); }

/* ⚠️ یک‌بار اجرا کن، بعد توکن رو از کد پاک کن */
function setupSecrets() {
  var props = PropertiesService.getScriptProperties();

  var NEW_TELEGRAM_TOKEN = "PASTE_NEW_BOT_TOKEN_HERE";

  if (NEW_TELEGRAM_TOKEN.indexOf("PASTE_") !== 0) {
    props.setProperty("TELEGRAM_TOKEN", NEW_TELEGRAM_TOKEN);
  }

  if (!props.getProperty("TELEGRAM_CHAT_ID")) {
    props.setProperty("TELEGRAM_CHAT_ID", "512163391");
  }

  var existing = props.getProperty("ORDER_API_KEY");
  if (!existing || existing.length < 32) {
    existing = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, "");
    props.setProperty("ORDER_API_KEY", existing);
  }

  Logger.log("ORDER_API_KEY = " + existing);
  Logger.log("این کلید رو تو Cloudflare با اسم ORDER_API_KEY ذخیره کن.");
  checkSetup();
}

/* بررسی سلامت تنظیمات */
