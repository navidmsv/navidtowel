/* =========================================================
   HELPERS
========================================================= */

function clean(value) {
  if (value === null || value === undefined) return "";
  return String(value).trim();
}

function numberValue(value) {
  if (value === null || value === undefined || value === "") return 0;

  var normalized = normalizeDigits(String(value))
    .replace(/[,٬،\s]/g, "")
    .replace(/تومان/g, "");

  var n = Number(normalized);
  return isFinite(n) ? n : 0;
}

function normalizeDigits(value) {
  return String(value || "")
    .replace(/[۰-۹]/g, function (c) { return "۰۱۲۳۴۵۶۷۸۹".indexOf(c); })
    .replace(/[٠-٩]/g, function (c) { return "٠١٢٣٤٥٦٧٨٩".indexOf(c); });
}

/* پاک‌سازی متن: کاراکترهای کنترلی، جعل جهت متن، و علامت‌های HTML */
function sanitizeText_(value, max, multiline) {
  var text = String(value == null ? "" : value).replace(/\r\n?/g, "\n");

  text = text.replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F\u202A-\u202E\u2066-\u2069]/g, "");
  text = text.replace(/[<>]/g, "");

  if (multiline) {
    text = text.replace(/[ \t]+/g, " ").replace(/\n{3,}/g, "\n\n");
  } else {
    text = text.replace(/\s+/g, " ");
  }

  return text.trim().slice(0, max);
}

function formatMoney(value) {
  var n = Math.round(Number(value) || 0);
  return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
}

function fail_(message) {
  return { ok: false, error: message };
}

/* =========================================================
   RESPONSE / JSONP
   callback فقط با پیشوند navidTowel پذیرفته می‌شه
   (صفحه‌ی چک‌اوت و صفحه‌ی پیگیری باید همین پیشوند رو استفاده کنن)
========================================================= */

function respond(e, data) {
  var callback = e && e.parameter && e.parameter.callback ? String(e.parameter.callback) : "";

  if (callback && /^navidTowel[A-Za-z0-9_]{0,60}$/.test(callback)) {
    return ContentService
      .createTextOutput(callback + "(" + JSON.stringify(data) + ");")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }

  return json(data);
}

function json(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}
